{
  "name": "prime",
  "description": "prime-agent's Rust binary on debian:trixie-slim, with its Python kernel prepared at build time",
  "agent": "prime",
  "from": "docker.io/library/debian:trixie-slim",
  "user": "agent",
  "home": "/home/agent",
  "sections": [
    {
      "name": "base-tools",
      "type": "apt",
      "description": "fd-find and ripgrep are the fd and rg prime-agent would otherwise download unpinned",
      "install": ["git", "ripgrep", "fd-find", "ca-certificates", "curl", "jq", "python3"]
    },
    {
      "name": "agent",
      "type": "archive",
      "description": "the archive stays whole: prime-agent finds its Python runtime and skills beside the executable",
      "artifacts": {
        "amd64": {
          "url": "https://github.com/PrimeIntellect-ai/prime-agent/releases/download/v0.10.2/prime-agent-0.10.2-linux-x64.tar.gz",
          "sha256": "09659961dfde201cc39f1e69b607385d708da3e591f267a4fea04970afb8b005"
        },
        "arm64": {
          "url": "https://github.com/PrimeIntellect-ai/prime-agent/releases/download/v0.10.2/prime-agent-0.10.2-linux-arm64.tar.gz",
          "sha256": "cd31de3a52dac3bdee44b723f10341cc5255f135acbcde8894575e324fa852b7"
        }
      },
      "dest": "/opt/prime-agent",
      "links": {"/usr/local/bin/prime-agent": "prime-agent"}
    },
    {
      "name": "uv",
      "type": "binary",
      "description": "the Rust build never installs uv and the kernel needs it. A pinned uv also pins the Python it installs",
      "artifacts": {
        "amd64": {
          "url": "https://github.com/astral-sh/uv/releases/download/0.13.6/uv-x86_64-unknown-linux-gnu.tar.gz",
          "sha256": "f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645",
          "member": "uv-x86_64-unknown-linux-gnu/uv"
        },
        "arm64": {
          "url": "https://github.com/astral-sh/uv/releases/download/0.13.6/uv-aarch64-unknown-linux-gnu.tar.gz",
          "sha256": "229e194255c7958d86d56e8790d969a6f74736592133f0dfd0076f754c642c1d",
          "member": "uv-aarch64-unknown-linux-gnu/uv"
        }
      }
    },
    {
      "name": "entrypoint",
      "type": "copy",
      "from": "files/sanduk-prime",
      "to": "/usr/local/bin/sanduk-prime",
      "mode": "0755"
    },
    {
      "name": "kernel",
      "type": "run",
      "user": "agent",
      "description": "the archive has no virtual environment, and a sealed run cannot fetch one",
      "lines": ["prime-agent --prime-agent-bootstrap"]
    }
  ],
  "env": {
    "PATH": "/home/agent/.local/bin:$PATH",
    "PRIME_AGENT_CODING_AGENT_DIR": "/home/agent/.prime/agent",
    "PI_OFFLINE": "1",
    "PI_SKIP_VERSION_CHECK": "1"
  },
  "entrypoint": ["sanduk-prime"]
}
